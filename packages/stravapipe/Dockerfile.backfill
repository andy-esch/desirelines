# Backfill Job - Cloud Run Job (Python)
# Multi-stage build for optimal container size
#
# Unlike bq_inserter and postgres_writer (Cloud Run services with uvicorn),
# this is a Cloud Run Job that runs to completion and exits.

# Build stage
FROM python:3.14-slim AS builder

WORKDIR /build

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.10.7 /uv /uvx /bin/

# Copy package files for dependency installation (context is packages/stravapipe)
COPY pyproject.toml README.md ./
COPY src/ ./src/

# Install the package with all dependencies using uv
RUN uv pip install --system --no-cache .

# Runtime stage
FROM python:3.14-slim AS runtime

WORKDIR /app

# Copy installed packages from builder stage
COPY --from=builder /usr/local/lib/python3.14/site-packages /usr/local/lib/python3.14/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy package source code (includes cloudrun module with backfill job)
COPY src/stravapipe ./stravapipe

# Create non-root system user and own application files
RUN useradd --system --no-create-home appuser && chown -R appuser:appuser /app/stravapipe
USER appuser

# Cloud Run Job - runs to completion, no port needed
CMD ["python", "-m", "stravapipe.cloudrun.backfill_job"]

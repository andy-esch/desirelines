# Dispatcher Go - Environment Variables

# Strava Webhook Configuration
STRAVA_WEBHOOK_VERIFY_TOKEN=your_verify_token_here
STRAVA_WEBHOOK_SUBSCRIPTION_ID=123456

# Google Cloud Configuration (all fail-fast-required by config.LoadConfig)
GCP_PROJECT_ID=local-dev
GCP_PUBSUB_TOPIC=strava-webhooks
GCP_PUBSUB_DEAUTH_TOPIC=strava-deauth
FIRESTORE_DATABASE=local-dev

# Optional Configuration
LOG_LEVEL=INFO
PORT=8080

# For local testing without real GCP credentials
PUBSUB_EMULATOR_HOST=localhost:8085

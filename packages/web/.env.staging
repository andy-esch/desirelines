# Staging environment configuration (deployed dev environment)
# Used by: just deploy-web dev
#
# This file is committed and contains only placeholders.
# Copy .env.staging.local.example to .env.staging.local with your actual credentials.

VITE_API_GATEWAY_URL=https://YOUR_STAGING_API_GATEWAY_URL
VITE_FIREBASE_API_KEY=YOUR_STAGING_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-staging-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-staging-project
VITE_FIREBASE_STORAGE_BUCKET=your-staging-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_STAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_STAGING_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_STAGING_MEASUREMENT_ID

# Mapbox public access token for the /routes slippy map (VITE_MAPBOX_TOKEN).
# PUBLIC, URL-restricted pk.* token — it ships in the client bundle, so it must
# NOT be a server/secret token. Restrict it to the deployed web origins in the
# Mapbox account (see README "Mapbox token"). It is provisioned via Infisical
# (/frontend) and exported into .env.staging.local by `just deploy-web dev`.
#
# Intentionally NOT assigned here: a committed placeholder would get baked into
# the bundle if the Infisical key is missing. Absence (undefined) is detectable;
# the deploy script requires a real pk.* token and the map degrades gracefully.

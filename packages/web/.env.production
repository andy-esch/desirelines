# Production environment configuration
# This file is committed to git and contains only non-sensitive defaults
#
# To use the production environment:
# 1. Copy this file to .env.production.local
# 2. Add your Firebase prod project credentials
# 3. Add your API Gateway URL (get from: terraform output cloud_run_stable_urls)
#
# Smart mode: Anonymous users see fixtures, authenticated users see backend data
# Used by: npm run build (default production mode)

# Disable fixture-only mode (will check auth state at runtime)
VITE_USE_FIXTURES=false

# API Gateway URL for authenticated users
# Get from: cd terraform/environments/prod && terraform output cloud_run_stable_urls
# Use the STABLE URL format: https://[function-name]-[project-number].[region].run.app
# VITE_API_GATEWAY_URL=

# Firebase Configuration
# Get from Firebase Console → Project Settings → Your apps → Web app config
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

{
  "name": "desirelines",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.18",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-router": "1.170.17",
    "axios": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.6.0",
    "mapbox-gl": "^3.25.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.1.1",
    "react-loading-skeleton": "^3.5.0",
    "react-map-gl": "^8.1.1",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.1.12"
  },
  "scripts": {
    "proto:gen": "cd ../.. && just proto-gen-web",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"./package.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --teardownTimeout=5000",
    "test:ui": "vitest --ui",
    "test:run": "vitest run --teardownTimeout=5000",
    "test:sequential": "vitest run --pool=forks --maxWorkers=1 --teardownTimeout=5000",
    "test:lowmem": "NODE_OPTIONS='--max-old-space-size=2048' vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --teardownTimeout=5000",
    "test:coverage": "vitest run --coverage",
    "test:integration": "firebase emulators:exec --only firestore,auth 'vitest run --config vitest.integration.config.ts'",
    "test:integration:watch": "firebase emulators:exec --only firestore,auth 'vitest --config vitest.integration.config.ts'",
    "emulators": "firebase emulators:start --only firestore,auth"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/router-plugin": "1.168.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.0",
    "prettier": "^3.6.2",
    "ts-proto": "^2.11.4",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    }
  }
}

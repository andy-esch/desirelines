{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // vite.config.ts imports TS files with explicit extensions (needed by Vite's native
    // config loader); that flag requires a no-JS-emit mode.
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true
  },
  "include": ["vite.config.ts"]
}

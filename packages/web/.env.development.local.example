# Development environment local overrides (copy to .env.development.local)
# This file is an example - DO NOT COMMIT .env.development.local
# .env.development.local is gitignored and should contain your actual credentials
#
# NOTE: Defaults are in .env.development and will be used automatically.
# Only add variables here if you need to override defaults or add credentials.

# Firebase Configuration (REQUIRED)
# Get from: Firebase Console → Your project → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-ABC123XYZ
VITE_FIREBASE_DATABASE_ID=desirelines-user-configs

# Firebase Emulators (uncomment to use local emulators instead of cloud)
# Requires: make start-frontend (starts firebase-emulators in Docker)
# This enables fully offline development with local Auth + Firestore
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_AUTH_EMULATOR_HOST=127.0.0.1
# VITE_AUTH_EMULATOR_PORT=9099
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
# VITE_FIRESTORE_EMULATOR_PORT=8089

# Optional overrides (uncomment to override defaults from .env.development)
# VITE_API_GATEWAY_URL=http://localhost:9000

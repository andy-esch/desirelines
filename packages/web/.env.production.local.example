# Example .env.production.local file
# Copy this file to .env.production.local and fill in the actual values

# INSTRUCTIONS:
# 1. Copy this file: cp .env.production.local.example .env.production.local
# 2. Get API Gateway URL from terraform: cd ../../terraform/environments/prod && terraform output api_gateway_url
# 3. Get Firebase config from Firebase Console:
#    - Go to https://console.firebase.google.com/
#    - Select your PRODUCTION project
#    - Go to Project Settings > General > Your apps
#    - Copy the config values from your web app

# Disable fixture-only mode (will check auth state at runtime)
VITE_USE_FIXTURES=false

# API Gateway URL for authenticated users (prod environment)
VITE_API_GATEWAY_URL=https://desirelines-prod-api-gateway-XXXXX-uc.a.run.app

# Firebase Configuration (prod project)
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=desirelines-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=desirelines-prod
VITE_FIREBASE_STORAGE_BUCKET=desirelines-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:xxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

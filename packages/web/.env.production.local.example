# Production environment local overrides (copy to .env.production.local)
# This file is an example - DO NOT COMMIT .env.production.local
# .env.production.local is gitignored and should contain your actual credentials
#
# Get values from:
# - API Gateway URL: cd terraform/environments/prod && terraform output cloud_run_stable_urls
# - Firebase config: Firebase Console → Your production project → Settings → Your apps

# API Gateway URL (REQUIRED)
VITE_API_GATEWAY_URL=https://your-prod-api-gateway.run.app

# Firebase Configuration (REQUIRED)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-prod-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-prod-project
VITE_FIREBASE_STORAGE_BUCKET=your-prod-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-ABC123XYZ
VITE_FIREBASE_DATABASE_ID=desirelines-user-configs

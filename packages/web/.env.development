# Local development environment configuration
# Used by: npm run dev (local development with localhost API Gateway)
#
# This file is committed to git and contains only non-sensitive defaults.
# Its Firebase values target the local emulators. To use a real Firebase project,
# put its values and VITE_USE_FIREBASE_EMULATORS=false in .env.development.local
# (gitignored), which overrides this file.
#
# For deployed dev environment, see .env.staging

# API Gateway URL for local development
# Override this in .env.development.local if your local API Gateway runs on a different port
VITE_API_GATEWAY_URL=http://localhost:8084/api

# Firebase Emulator Configuration
# When true, Firebase SDK connects to local emulators (Auth + Firestore)
# Run: just start-frontend (starts docker-compose with emulators)
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8089

# Firebase project the emulators run (.firebaserc, the emulator container's
# --project). The emulators accept any API key. The API gateway verifies tokens
# against this project, so keep it in step with the backend's GCP_PROJECT_ID.
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=desirelines-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=desirelines-local

# Mapbox public token for the /routes slippy map is also provisioned via
# Infisical (/frontend) and written into .env.development.local by
# `just setup-secrets`. Without it, /routes shows a graceful "map unavailable"
# state. See README "Mapbox token".

# Local development environment configuration
# Used by: npm run dev (local development with localhost API Gateway)
#
# This file is committed to git and contains only non-sensitive defaults.
# Create .env.development.local (gitignored) with your actual Firebase credentials.
#
# For deployed dev environment, see .env.staging

# Smart mode: Anonymous users see fixtures, authenticated users see backend data
VITE_USE_FIXTURES=false

# API Gateway URL for local development
# Override this in .env.development.local if your local API Gateway runs on a different port
VITE_API_GATEWAY_URL=http://localhost:8084

# Firebase Emulator Configuration
# Set to true in .env.development.local to use local Firebase emulators
# Run: make start-frontend (starts docker-compose with firestore-emulator)
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8089

# Firebase Configuration is set in .env.development.local (gitignored)

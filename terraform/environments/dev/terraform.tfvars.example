# Development environment configuration
# Copy this file to terraform.tfvars and customize for your GCP project

gcp_project_id     = "your-gcp-project-id"
gcp_project_number = "your-gcp-project-number"  # Found in GCP Console project settings
gcp_region         = "us-central1"              # Choose your preferred region

deployment_version = "abc1234"                 # Git SHA for deployed code (Cloud Run images and Cloud Function sources)

# Developer access
developer_email = "your-email@example.com"     # For BigQuery console access

# Cross-project access (optional - set to enable prod pulling images from dev)
# prod_project_number = "123456789012"         # Prod project number for Artifact Registry access

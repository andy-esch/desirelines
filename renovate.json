{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "group:monorepos",
    "monorepo:react",
    "monorepo:tanstack-query",
    "monorepo:tanstack-router"
  ],
  "postUpdateOptions": ["gomodTidy", "npmDedupe"],
  "terraform": {
    "enabled": true
  },
  "terraform-version": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Pin PostGIS to PostgreSQL v17 - major version bumps require database migration",
      "matchPackageNames": ["postgis/postgis"],
      "allowedVersions": "17.x"
    },
    {
      "description": "Pin Go to 1.25.x across all managers (Go modules, GitHub Actions, Docker)",
      "matchPackagePatterns": ["^go$", "^golang$"],
      "matchManagers": ["gomod", "github-actions", "dockerfile"],
      "matchDatasources": ["go", "golang-version", "docker"],
      "allowedVersions": "1.25.x",
      "groupName": "go version"
    },
    {
      "description": "Group Vite ecosystem so peer-dep-coupled major bumps land in one PR",
      "matchPackageNames": ["vite"],
      "matchPackagePatterns": ["^@vitejs/", "^@tailwindcss/vite$"],
      "groupName": "vite"
    },
    {
      "description": "Group all Terraform updates into one PR",
      "matchManagers": ["terraform", "terraform-version"],
      "groupName": "terraform updates"
    }
  ]
}

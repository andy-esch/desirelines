{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "terraform": {
    "enabled": true
  },
  "terraform-version": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group all Dockerfile base image updates into one PR",
      "matchManagers": ["dockerfile"],
      "groupName": "dockerfile base images"
    },
    {
      "description": "Group all Go module updates into one PR",
      "matchManagers": ["gomod"],
      "groupName": "go modules"
    },
    {
      "description": "Group all GitHub Actions updates into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group all TanStack updates into one PR",
      "matchPackagePrefixes": ["@tanstack/"],
      "groupName": "tanstack"
    },
    {
      "description": "Group React and related type updates into one PR",
      "matchPackageNames": ["react", "react-dom"],
      "matchPackagePrefixes": ["@types/react", "@types/react-dom"],
      "groupName": "react"
    },
    {
      "description": "Group all other npm updates into one PR",
      "matchManagers": ["npm"],
      "excludePackagePrefixes": ["@tanstack/"],
      "excludePackageNames": ["react", "react-dom"],
      "groupName": "npm dependencies"
    },
    {
      "description": "Group all docker-compose image updates into one PR",
      "matchManagers": ["docker-compose"],
      "groupName": "docker-compose images"
    },
    {
      "description": "Pin PostGIS to PostgreSQL v17 - major version bumps require database migration",
      "matchPackageNames": ["postgis/postgis"],
      "allowedVersions": "/^17-\\d+\\.\\d+/"
    },
    {
      "description": "Pin Go to 1.25.x - wait for ecosystem tooling to catch up with 1.26",
      "matchPackageNames": ["golang", "go"],
      "allowedVersions": "<1.26.0"
    },
    {
      "description": "Group all Terraform updates into one PR",
      "matchManagers": ["terraform", "terraform-version"],
      "groupName": "terraform updates"
    }
  ]
}

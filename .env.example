# Example environment file for local development (docker-compose)
# Copy this to .env and fill in your values
#
# Note: Frontend VITE_* variables are managed in packages/web/.env.*
# This file is for backend services in docker-compose.yml

# ===========================================
# API Gateway Authentication
# ===========================================
# Comma-separated list of emails authorized to access real data
# Must match the email used for Strava OAuth login
ALLOWED_EMAILS=your-email@example.com

# GCP project ID for Firebase Admin SDK (must match your Firebase project)
# This is used to verify JWT tokens from Firebase Auth
GCP_PROJECT_ID_LIVE=desirelines-dev

# ===========================================
# GCP Configuration
# ===========================================
GCP_PROJECT_ID=desirelines-local
GCP_BIGQUERY_DATASET=desirelines

# ===========================================
# Strava API Configuration
# ===========================================
# Get these from Strava API Application settings or Secret Manager
STRAVA_CLIENT_ID=your-client-id
STRAVA_CLIENT_SECRET=your-client-secret
STRAVA_REFRESH_TOKEN=your-refresh-token

# Strava Webhook Configuration (for dispatcher)
STRAVA_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
STRAVA_WEBHOOK_SUBSCRIPTION_ID=your-subscription-id

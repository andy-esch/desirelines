# Build stage
FROM python:3.12-slim AS builder

WORKDIR /build

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy pyproject.toml for dependency installation
COPY packages/stravapipe/pyproject.toml ./

# Install dependencies using uv (much faster than pip)
RUN uv pip install --system --no-cache -r pyproject.toml

# Runtime stage
FROM python:3.12-slim AS runtime

WORKDIR /app

# Copy installed packages from builder stage
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy package source code
COPY packages/stravapipe/src/stravapipe ./stravapipe

# Copy function code
COPY functions/postgres_writer.py ./main.py

# Set the function target
ENV FUNCTION_TARGET=main

# Expose port 8080
EXPOSE 8080

# Start the functions framework
CMD exec functions-framework --target=${FUNCTION_TARGET} --port=8080

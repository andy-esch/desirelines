# Sync all local environment files from Infisical
setup-secrets:
    #!/usr/bin/env bash
    set -euo pipefail

    # set -e + ERR trap: any failed fetch removes the partial output files (so a
    # retry starts clean and nothing reads a half-written file) and reports it.
    # The last "Fetching <path>..." line above shows which fetch failed.
    cleanup() {
        echo "❌ Secret sync failed (see the last 'Fetching ...' line above). Run 'infisical login' and retry." >&2
        rm -f .env.local packages/web/.env.development.local strava-auth-local.json
    }
    trap cleanup ERR

    echo "🔐 Syncing secrets from Infisical..."

    # 1. Export Backend .env (Merge root, backend/secrets, and backend/config folders)
    echo "   📦 Generating root .env.local..."
    echo "# Generated by Infisical" > .env.local

    echo "      - Fetching /..."
    infisical export --env=local --path=/ --format=dotenv >> .env.local

    echo "      - Fetching /backend/secrets..."
    infisical export --env=local --path=/backend/secrets --format=dotenv >> .env.local

    echo "      - Fetching /backend/config..."
    infisical export --env=local --path=/backend/config --format=dotenv >> .env.local

    echo "      - Fetching /local..."
    infisical export --env=local --path=/local --format=dotenv >> .env.local

    # 2. Export Frontend .env
    echo "   📦 Generating packages/web/.env.development.local..."
    infisical export --env=local --path=/frontend --format=dotenv > packages/web/.env.development.local

    # 3. Generate Strava JSON from template
    # Note: We need to feed variables from the /backend/secrets path into the template
    echo "   📦 Generating strava-auth-local.json..."
    infisical export --env=local --path=/backend/secrets --format=template --template=local-dev/templates/strava-auth.tmpl.json > strava-auth-local.json

    echo "✅ Secrets synced successfully"

# Auto-fix markdown formatting issues
md-format:
    #!/usr/bin/env bash
    if command -v markdownlint-cli2 >/dev/null 2>&1; then
        echo "Formatting markdown files..."
        markdownlint-cli2 --fix --config .github/.markdownlint-cli2.yaml '**/*.md' '#node_modules' '#packages/web/node_modules' '#.venv'
    elif npx --yes markdownlint-cli2 --help >/dev/null 2>&1; then
        echo "Formatting markdown files (via npx)..."
        npx markdownlint-cli2 --fix --config .github/.markdownlint-cli2.yaml '**/*.md' '#node_modules' '#packages/web/node_modules' '#.venv'
    else
        echo "markdownlint-cli2 not found. Install with: npm install -g markdownlint-cli2"
        exit 1
    fi

# Lint shell scripts using shellcheck (covers both scripts/ and local-dev/).
# In CI ($CI is set), a missing shellcheck is a hard error — defense in
# depth against the install step being silently broken or removed.
# Locally it skips gracefully so contributors aren't forced to install it.
sh-lint:
    #!/usr/bin/env bash
    if ! command -v shellcheck >/dev/null 2>&1; then
        if [[ -n "${CI:-}" ]]; then
            echo "❌ shellcheck not found (required in CI)."
            exit 1
        fi
        echo "⚠️  shellcheck not found. Skipping."
        exit 0
    fi
    echo "🐚 Linting scripts with shellcheck..."
    find scripts local-dev -name "*.sh" -exec shellcheck {} +

# Format shell scripts using shfmt (covers both scripts/ and local-dev/)
sh-format:
    #!/usr/bin/env bash
    if command -v shfmt >/dev/null 2>&1; then
        echo "🎨 Formatting scripts with shfmt..."
        find scripts local-dev -name "*.sh" -exec shfmt -w -i 2 -ci {} +
    else
        echo "⚠️  shfmt not found. Skipping."
    fi

# Verify shell scripts are formatted per the project style (-i 2 -ci),
# without mutating the working tree. Exits non-zero with the diff
# printed if any script needs reformatting. Wired into CI so format
# drift is caught at PR time; locally, run `just sh-format` to fix.
sh-format-check:
    #!/usr/bin/env bash
    set -euo pipefail
    # In CI ($CI is set), missing shfmt is a hard error — otherwise a
    # silently-removed install step would let this gate pass green
    # without actually checking anything.
    if ! command -v shfmt >/dev/null 2>&1; then
        if [[ -n "${CI:-}" ]]; then
            echo "❌ shfmt not found (required in CI)."
            exit 1
        fi
        echo "⚠️  shfmt not found. Skipping."
        exit 0
    fi
    echo "🎨 Checking script formatting with shfmt..."
    if ! find scripts local-dev -name "*.sh" -exec shfmt -d -i 2 -ci {} + ; then
        echo "❌ Scripts not formatted. Run 'just sh-format' and commit."
        exit 1
    fi
    echo "✓ All scripts formatted."

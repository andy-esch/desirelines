rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // // Helper function for development mode (allows unauthenticated access to 'default' user)
    // // TODO: Remove this before production deployment
    // function isDefaultUserDev(userId) {
    //   return userId == 'default';
    // }

    // Allowlist collection — backend-only (Admin SDK bypasses rules)
    // Documents keyed by Strava athlete ID. Only the API gateway writes/reads
    // these during OAuth callback. No client-side access needed.
    match /allowlist/{athleteId} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {

      // Profile data - read by owner only
      match /profile/{document=**} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Private data - read/write by owner only
      match /private/{document=**} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Config data - read/write by owner only
      match /config/{version} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                    && request.resource.data.keys().hasAll(['schemaVersion', 'userId', 'lastUpdated'])
                    && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
